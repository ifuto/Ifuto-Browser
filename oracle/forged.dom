#document
<html>
  <head>
  <body>
    <h1>
      #text "T1"
    <p>
      #text "Para with "
      <strong>
        #text "b"
      #text " and "
      <em>
        #text "i"
      #text " and "
      <code>
        #text "c"
      #text " and "
      <a href="x">
        #text "L"
      #text " and <span class='z'>html</span> inline end."
    <h2>
      #text "T2 "
      <del>
        #text "del"
      #text " "
      <strong>
        #text "*bi"
      #text "* "
      <a href="https://e.jp/あ">
        #text "link2"
      #text " "
      <img src="img.png" alt="alt9">
    <h3>
      #text "Q1"
    <blockquote>
      <p>
        #text "quote L1 quote "
        <strong>
          #text "L2"
        #text " with "
        <a href="u">
          #text "ql"
      <p>
        #text "    indented?"
      <ul>
        <li>
          #text "q item1"
        <li>
          #text "q item2"
          <ul>
            <li>
              #text "q nested"
          #text "\n"
    <p>
      #text "| 項目 | 値 | | ---- | --: | | a    | -3x | |…"
    <table>
      <thead>
        <tr>
          <th>
            #text "not-a-table"
      <tbody>
    <pre>
      <code class="lang-rust">
        #text "fn main() { println!(\"hi\"); }\n"
    <pre>
      <code>
        #text "plain fence\n"
    <pre>
      <code>
        #text "\ntilde fence\n\n"
    <ol>
      <li>
        #text "one"
      <li>
        #text "two"
      <li>
        #text "three"
    <ul>
      <li>
        #text "a"
      <li>
        #text "b"
        <ul>
          <li>
            #text "b1"
          <li>
            #text "b2"
        #text "\n"
      <li>
        #text "c"
    <ul>
      <li>
        #text "loose a"
    <ul>
      <li>
        #text "loose b"
    <ul>
      <li>
        #text "plus1"
      <li>
        #text "plus2"
    <hr>
    <hr>
    <hr>
    <h4>
      #text "Foot"
    <p>
      #text "Use note"
      <sup>
        <a href="#fn-a" id="fr-a">
          #text "1"
      #text " and another"
      <sup>
        <a href="#fn-b" id="fr-b">
          #text "2"
      #text "."
    <h5>
      #text "Misc"
    <p>
      #text "Escaped *not bold* and `not code`."
    <p>
      #text "日本語の段落テキスト。全角カナ、…"
    <p>
      #text "Mixed 日本語 and English in one line with <b>…"
    <p>
      #text "<div>html block</div>"
    <p>
      #text "<a name=\"anchor\"></a>"
    <p>
      #text "Nested <a href=\"x\">outer <a href=\"y\">inner</a></…"
    <h6>
      #text "Deepest H6"
    <p>
      #text "文字だけの行   インデント2の行 	tab…"
    <p>
      #text "半角カナ ABC "
      <a href="dest">
        #text "link with "
        <strong>
          #text "bold label"
    <p>
      <em>
        #text "em with "
        <code>
          #text "code"
        #text " inside"
    <p>
      <strong>
        #text "bold with "
        <em>
          #text "em"
        #text " inside"
    <p>
      #text "End with trailing ws"
    <section class="footnotes">
      <hr>
      <ol>
        <li id="fn-a">
          #text "First note "
          <a href="#fr-a">
            #text "↩"
        <li id="fn-b">
          #text "Second with "
          <strong>
            #text "bold"
          #text " "
          <a href="#fr-b">
            #text "↩"
; nodes=168 errors=1 title=""
